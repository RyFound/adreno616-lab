#version 450
// vkopt K=2 BATCH variant: the first accumulator is seeded from z[i], so repeated
// dispatches into ONE command buffer accumulate instead of overwriting.
// Gate after R dispatches: C0 == K*iters*R (K=2).
// Derivation: dispatch r starts a0 at (r-1)*2*iters and adds iters; a1 always
// runs 0 -> iters. So z = 2*(r-1)*iters + iters + iters = 2*r*iters.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer X { vec4 x[]; };
layout(std430, binding = 1) buffer Y { vec4 y[]; };
layout(std430, binding = 2) buffer Z { vec4 z[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 xv = x[i];
    vec4 yv = y[i];
    vec4 a0 = z[i];
    vec4 a1 = vec4(0.0);
    for (uint k = 0u; k < pc.iters; k++) {
        a0 = a0 * xv + yv;
        a1 = a1 * xv + yv;
    }
    z[i] = a0 + a1;
}
