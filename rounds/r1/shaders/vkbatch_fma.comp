#version 450
// Variant that FORCES the correctly-rounded fma() builtin in GLSL, to test whether
// Vulkan has the same codegen cliff that OpenCL hits with fma().
// If this is slow while the mul+add version is fast, the cliff is in the driver/
// instruction, not in the OpenCL loader.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer X { vec4 x[]; };
layout(std430, binding = 1) buffer Y { vec4 y[]; };
layout(std430, binding = 2) buffer Z { vec4 z[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 xv = x[i];
    vec4 yv = y[i];
    vec4 zv = z[i];
    for (uint k = 0u; k < pc.iters; k++) {
        zv = fma(zv, xv, yv);
    }
    z[i] = zv;
}
