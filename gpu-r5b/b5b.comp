#version 450
// r5b control: identical math to r5_b5, but a2/a3 defined AFTER the loop
// (same epilog, same output, no loop-crossing live range).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer X { vec4 x[]; };
layout(std430, binding = 1) buffer Y { vec4 y[]; };
layout(std430, binding = 2) buffer Z { vec4 z[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 xv = x[i];
    vec4 yv = y[i];
    vec4 a0 = vec4(0.0);
    vec4 a1 = vec4(0.0);
    for (uint k = 0u; k < pc.iters; k++) {
        a0 = a0 * xv + yv;
        a1 = a1 * xv + yv;
    }
    vec4 a2 = yv;
    vec4 a3 = a2 + yv;
    z[i] = a0 + a1 + a2 + a3 - vec4(3.0);
}
