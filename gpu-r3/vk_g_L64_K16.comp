#version 450
// generated from one template, L=64 K=16
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer X { vec4 x[]; };
layout(std430, binding = 1) buffer Y { vec4 y[]; };
layout(std430, binding = 2) buffer Z { vec4 z[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 xv = x[i];
    vec4 yv = y[i];
    vec4 a0 = vec4(0.0);
    vec4 a1 = vec4(0.0);
    vec4 a2 = vec4(0.0);
    vec4 a3 = vec4(0.0);
    vec4 a4 = vec4(0.0);
    vec4 a5 = vec4(0.0);
    vec4 a6 = vec4(0.0);
    vec4 a7 = vec4(0.0);
    vec4 a8 = vec4(0.0);
    vec4 a9 = vec4(0.0);
    vec4 a10 = vec4(0.0);
    vec4 a11 = vec4(0.0);
    vec4 a12 = vec4(0.0);
    vec4 a13 = vec4(0.0);
    vec4 a14 = vec4(0.0);
    vec4 a15 = vec4(0.0);
    for (uint k = 0u; k < pc.iters; k++) {
        a0 = a0 * xv + yv;
        a1 = a1 * xv + yv;
        a2 = a2 * xv + yv;
        a3 = a3 * xv + yv;
        a4 = a4 * xv + yv;
        a5 = a5 * xv + yv;
        a6 = a6 * xv + yv;
        a7 = a7 * xv + yv;
        a8 = a8 * xv + yv;
        a9 = a9 * xv + yv;
        a10 = a10 * xv + yv;
        a11 = a11 * xv + yv;
        a12 = a12 * xv + yv;
        a13 = a13 * xv + yv;
        a14 = a14 * xv + yv;
        a15 = a15 * xv + yv;
    }
    z[i] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15;
}
