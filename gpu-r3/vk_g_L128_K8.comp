#version 450
// generated from one template, L=128 K=8
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer X { vec4 x[]; };
layout(std430, binding = 1) buffer Y { vec4 y[]; };
layout(std430, binding = 2) buffer Z { vec4 z[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 xv = x[i];
    vec4 yv = y[i];
    vec4 a0 = vec4(0.0);
    vec4 a1 = vec4(0.0);
    vec4 a2 = vec4(0.0);
    vec4 a3 = vec4(0.0);
    vec4 a4 = vec4(0.0);
    vec4 a5 = vec4(0.0);
    vec4 a6 = vec4(0.0);
    vec4 a7 = vec4(0.0);
    for (uint k = 0u; k < pc.iters; k++) {
        a0 = a0 * xv + yv;
        a1 = a1 * xv + yv;
        a2 = a2 * xv + yv;
        a3 = a3 * xv + yv;
        a4 = a4 * xv + yv;
        a5 = a5 * xv + yv;
        a6 = a6 * xv + yv;
        a7 = a7 * xv + yv;
    }
    z[i] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
}
