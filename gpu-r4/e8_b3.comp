#version 450
// E8-B3: positive control. 2 accumulators, 2 fma per iteration.
// Same op/iter as the original K=2 kernel; must reproduce the ~109 GFLOPS spike.
// Run with K=2 so harness gate (expect = iters*K*R) matches exactly.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer X { vec4 x[]; };
layout(std430, binding = 1) buffer Y { vec4 y[]; };
layout(std430, binding = 2) buffer Z { vec4 z[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 xv = x[i];
    vec4 yv = y[i];
    vec4 a0 = vec4(0.0);
    vec4 a1 = vec4(0.0);
    for (uint k = 0u; k < pc.iters; k++) {
        a0 = a0 * xv + yv;
        a1 = a1 * xv + yv;
    }
    z[i] = a0 + a1;
}
