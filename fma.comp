#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer A { vec4 a[]; };
layout(set = 0, binding = 1) buffer B { vec4 b[]; };
layout(set = 0, binding = 2) buffer C { vec4 c[]; };
layout(push_constant) uniform PC { int iters; } pc;
void main() {
    uint g = gl_GlobalInvocationID.x;
    vec4 x = a[g], y = b[g], z = c[g];
    for (int i = 0; i < pc.iters; i++) { z = fma(x, y, z); }
    c[g] = z;
}
